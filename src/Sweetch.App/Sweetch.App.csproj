<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Sweetch</AssemblyName>
    <RootNamespace>Sweetch.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Sweetch.ico</ApplicationIcon>
    <StartupObject>Sweetch.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!--
      Smaller download: trim only libraries marked as trim-safe (the .NET runtime, the Windows SDK projection…);
      WPF, WinForms and our own code are kept whole. The UI self-test in CI runs conversions in the trimmed build.
    -->
    <!-- Explorer selection and Outlook drops use classic COM, which trimming turns off by default. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Product>Sweetch</Product>
    <Authors>mmmorozov</Authors>
    <Company>mmmorozov</Company>
    <Copyright>Sweetch modifications © 2026 mmmorozov. Third-party notices included.</Copyright>
    <Description>Конвертация файлов через круговое меню</Description>
    <!-- ThemeMode (Fluent) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Only when publishing for a platform (trimming needs a runtime identifier). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous; WinForms is only used for the tray icon and shell copy dialogs. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Sweetch.ico" />
    <Resource Include="Assets\Sweetch.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sweetch.Core\Sweetch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!--
    LibVLC for the trim player: x64 only, and only what local playback needs
    (no network access, streaming, encoders, subtitles or Lua) — about a third of the full 109 MB.
  -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll;plugins\access\libfilesystem_plugin.dll;plugins\access\libidummy_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\codec\%2A%2A;plugins\demux\%2A%2A;plugins\packetizer\%2A%2A;plugins\stream_filter\%2A%2A;plugins\logger\%2A%2A" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_output\%2A%2A;plugins\audio_filter\%2A%2A;plugins\audio_mixer\%2A%2A" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_output\%2A%2A;plugins\video_chroma\%2A%2A;plugins\video_filter\%2A%2A;plugins\d3d11\%2A%2A;plugins\d3d9\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libx26410b_plugin.dll;plugins\codec\libx264_plugin.dll;plugins\codec\libx265_plugin.dll;plugins\codec\libaom_plugin.dll;plugins\codec\libqsv_plugin.dll;plugins\codec\libtwolame_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\liblibass_plugin.dll;plugins\codec\libzvbi_plugin.dll;plugins\codec\libfluidsynth_plugin.dll;plugins\codec\libcrystalhd_plugin.dll;plugins\codec\libkate_plugin.dll" />
  </ItemGroup>

</Project>
