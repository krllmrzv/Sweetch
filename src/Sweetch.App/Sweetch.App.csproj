<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Sweetch</AssemblyName>
    <RootNamespace>Sweetch.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Sweetch.ico</ApplicationIcon>
    <StartupObject>Sweetch.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>2.1.2</Version>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!--
      Smaller download: trim only libraries marked as trim-safe (the .NET runtime, the Windows SDK projection…);
      WPF, WinForms and our own code are kept whole. The UI self-test in CI runs conversions in the trimmed build.
    -->
    <!-- Explorer selection and Outlook drops use classic COM, which trimming turns off by default. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Product>Sweetch</Product>
    <Authors>mmmorozov</Authors>
    <Company>mmmorozov</Company>
    <Copyright>Sweetch modifications © 2026 mmmorozov. Third-party notices included.</Copyright>
    <Description>Конвертация файлов через круговое меню</Description>
    <!-- ThemeMode (Fluent) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Only when publishing for a platform (trimming needs a runtime identifier). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous; WinForms is only used for the tray icon and shell copy dialogs. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Sweetch.ico" />
    <Resource Include="Assets\Sweetch.png" />
    <!-- Onest (OFL) and the icon subset of Material Symbols (Apache 2.0); rebuilt by scripts/build-fonts.py. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sweetch.Core\Sweetch.Core.csproj" />
  </ItemGroup>

</Project>
